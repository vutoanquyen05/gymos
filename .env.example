# PostgreSQL Local Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gymos

# Database Connection URL (Localhost only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gymos?schema=public

# Backend API Configuration (Cổng 3005 tránh xung đột với Antigravity IDE cục bộ trên cổng 3000/3001)
PORT=3005
NODE_ENV=development

# Web Frontend Environment
VITE_API_URL=http://localhost:3005/api/v1

# Mobile App Environment
EXPO_PUBLIC_API_URL=http://localhost:3005/api/v1
